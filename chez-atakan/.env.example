# Copier en .env.local pour le développement, ou définir dans le workflow GitHub Actions.

# Mode démonstration (true par défaut). Ne passer à false qu'avec un vrai backend.
VITE_DEMO_MODE=true

# URL de l'API de commandes (futur backend). Ignorée tant que VITE_DEMO_MODE=true.
# VITE_ORDERS_API_URL=https://api.example.com

# Point d'accès serveur qui renvoie la note et les avis Google (jamais de clé API ici).
# VITE_REVIEWS_ENDPOINT=https://api.example.com/reviews

# Base de publication (fournie par le workflow GitHub Pages).
# VITE_BASE=/63_website/chez-atakan/
