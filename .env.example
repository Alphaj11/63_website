# --- Avis Google (uniquement sur un hébergement avec serveur : Vercel, Netlify, VPS…) ---
# Clé Google Places API (New). Ne JAMAIS la préfixer par NEXT_PUBLIC_ : elle doit rester côté serveur.
GOOGLE_PLACES_API_KEY=
# Identifiant Google de la fiche (Place ID) de Kebab Grill House 63.
GOOGLE_PLACE_ID=

# --- Côté navigateur (sans secret) ---
# URL de la route serveur qui renvoie les avis (ex. https://votre-domaine.fr/api/reviews).
# Vide = la section avis reste en mode démonstration.
NEXT_PUBLIC_REVIEWS_ENDPOINT=
# Place ID public, utilisé pour construire les liens officiels « Voir tous nos avis » et « Laisser un avis ».
NEXT_PUBLIC_GOOGLE_PLACE_ID=
